$threshold_function
function (predicted_output, labels, metric = c("accuracy", "f1", 
    "precision", "recall", "macro_f1", "macro_precision", "macro_recall"), 
    threshold_grid = seq(0.05, 0.95, by = 0.01), verbose = FALSE) 
{
    grid <- threshold_grid
    metric <- match.arg(metric)
    if (missing(grid) || is.null(grid) || is.function(grid) || 
        is.environment(grid) || is.list(grid)) {
        grid <- seq(0.05, 0.95, by = 0.01)
    }
    else {
        grid <- tryCatch(as.numeric(unlist(grid, use.names = FALSE)), 
            error = function(e) numeric(0))
        grid <- grid[is.finite(grid)]
        grid <- grid[grid > 0 & grid < 1]
        grid <- sort(unique(grid))
        if (length(grid) == 0L) 
            grid <- seq(0.05, 0.95, by = 0.01)
    }
    P <- as.matrix(predicted_output)
    storage.mode(P) <- "double"
    L <- as.matrix(labels)
    storage.mode(L) <- "double"
    nL <- ncol(L)
    nP <- ncol(P)
    K <- max(nL, nP)
    if (K < 1L) 
        K <- 1L
    if (ncol(P) < K) {
        total_needed <- nrow(L) * K
        replicated <- rep(as.vector(P), length.out = total_needed)
        P <- matrix(replicated, nrow = nrow(L), ncol = K, byrow = FALSE)
    }
    else if (ncol(P) > K) {
        P <- P[, 1:K, drop = FALSE]
    }
    if (K == 1L) {
        y_true <- as.numeric(L[, 1])
        y_true01 <- as.integer(ifelse(y_true > 0, 1L, 0L))
        best_t <- NA_real_
        best_val <- -Inf
        best_pred <- NULL
        for (t in grid) {
            y_pred <- as.integer(P[, 1] >= t)
            TP <- sum(y_pred == 1 & y_true01 == 1)
            FP <- sum(y_pred == 1 & y_true01 == 0)
            FN <- sum(y_pred == 0 & y_true01 == 1)
            prec <- TP/(TP + FP + 1e-08)
            rec <- TP/(TP + FN + 1e-08)
            val <- switch(metric, accuracy = mean(y_pred == y_true01), 
                f1 = 2 * prec * rec/(prec + rec + 1e-08), precision = prec, 
                recall = rec)
            if (val > best_val) {
                best_val <- val
                best_t <- t
                best_pred <- y_pred
            }
        }
        tuned_acc <- mean(best_pred == y_true01)
        if (verbose) 
            cat(sprintf("[Binary] best_t=%.3f | tuned_%s=%.6f\n", 
                best_t, metric, best_val))
        return(list(thresholds = best_t, y_pred_class = best_pred, 
            tuned_score = as.numeric(best_val), tuned_accuracy = as.numeric(tuned_acc), 
            metric_used = metric))
    }
    if (ncol(L) > 1L) {
        y_true_ids <- max.col(L, ties.method = "first")
    }
    else {
        cls <- as.integer(L[, 1])
        if (min(cls, na.rm = TRUE) == 0L) 
            cls <- cls + 1L
        cls[cls < 1L] <- 1L
        cls[cls > K] <- K
        y_true_ids <- cls
    }
    thr <- numeric(K)
    for (k in seq_len(K)) {
        y_true01 <- as.integer(y_true_ids == k)
        best_tk <- NA_real_
        best_valk <- -Inf
        for (t in grid) {
            y_pred01 <- as.integer(P[, k] >= t)
            TP <- sum(y_pred01 == 1 & y_true01 == 1)
            FP <- sum(y_pred01 == 1 & y_true01 == 0)
            FN <- sum(y_pred01 == 0 & y_true01 == 1)
            prec <- TP/(TP + FP + 1e-08)
            rec <- TP/(TP + FN + 1e-08)
            val <- switch(metric, macro_f1 = 2 * prec * rec/(prec + 
                rec + 1e-08), macro_precision = prec, macro_recall = rec, 
                accuracy = mean(y_pred01 == y_true01))
            if (val > best_valk) {
                best_valk <- val
                best_tk <- t
            }
        }
        thr[k] <- best_tk
    }
    masked <- P
    for (k in seq_len(K)) masked[, k] <- ifelse(P[, k] >= thr[k], 
        P[, k], -Inf)
    y_pred_ids <- max.col(masked, ties.method = "first")
    all_neg_inf <- !is.finite(apply(masked, 1, max))
    if (any(all_neg_inf)) {
        y_pred_ids[all_neg_inf] <- max.col(P[all_neg_inf, , drop = FALSE], 
            ties.method = "first")
    }
    tuned_acc <- mean(y_pred_ids == y_true_ids)
    tuned_score <- tuned_acc
    if (metric %in% c("macro_f1", "macro_precision", "macro_recall")) {
        tab <- table(factor(y_true_ids, levels = 1:K), factor(y_pred_ids, 
            levels = 1:K))
        TPk <- diag(tab)
        FPk <- colSums(tab) - TPk
        FNk <- rowSums(tab) - TPk
        Prec_k <- ifelse((TPk + FPk) > 0, TPk/(TPk + FPk), 0)
        Rec_k <- ifelse((TPk + FNk) > 0, TPk/(TPk + FNk), 0)
        if (metric == "macro_precision") 
            tuned_score <- mean(Prec_k)
        if (metric == "macro_recall") 
            tuned_score <- mean(Rec_k)
        if (metric == "macro_f1") {
            F1_k <- ifelse((Prec_k + Rec_k) > 0, 2 * Prec_k * 
                Rec_k/(Prec_k + Rec_k), 0)
            tuned_score <- mean(F1_k)
        }
    }
    if (verbose) {
        cat(sprintf("[Multiclass] tuned_acc=%.6f | metric=%s\n", 
            tuned_acc, metric))
        cat(" thresholds: ", paste0(sprintf("%.3f", thr), collapse = ", "), 
            "\n")
    }
    return(list(thresholds = thr, y_pred_class = y_pred_ids, 
        tuned_score = as.numeric(tuned_score), tuned_accuracy = as.numeric(tuned_acc), 
        metric_used = metric))
}
