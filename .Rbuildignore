# ============================================================
# CRAN / R CMD build ignores
# ============================================================

# Dev-only folders (must NEVER ship)
^inst/dev$
^inst/dev/.*$

# MVP / experimental work
^_DDESONN_MVP_Test$
^_DDESONN_MVP_Test/.*$

# RStudio / IDE
^\.Rproj\.user$
^\.Rhistory$
^\.RData$
^\.Ruserdata$
^DDESONN\.Rproj$

# Git / VCS
^\.git$
^\.gitignore$
^\.github$
^\.github/.*$

# Build artifacts
^dist$
^build$
^tarballs$
^\.tar\.gz$

# OS junk
^Thumbs\.db$
^\.DS_Store$

# Large analysis outputs / scratch
^analysis$
^analysis/.*$
^scratch$
^scratch/.*$

# Quarto / vignette intermediates (safe to ignore)
^vignettes/.*\.knit\.md$
^vignettes/.*\.utf8\.md$
^vignettes/.*_files$
^vignettes/.*_cache$
^doc$
^Meta$
