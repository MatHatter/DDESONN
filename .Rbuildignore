# ============================================================
# FILE: .Rbuildignore
# FULL FIXED — block vignette output folders that break Windows build copy
#
# PRESERVED:
# - Your entire existing ignore set + structure
#
# FIX:
# - Ignore knitr fig/cache roots that you set in vignette opts (figure-html/, cache/)   #$$$$$$$$$$$$$
# - Ignore DDESONN vignette-run artifact roots (DDESONN_plots_*)                        #$$$$$$$$$$$$$
# - Slightly safer tarball pattern                                                     #$$$$$$$$$$$$$
# - Ignore stdout / stderr runtime capture dirs                                        #$$$$$$$$$$$$$
# ============================================================

# ============================================================
# CRAN / R CMD build ignores
# ============================================================

# Dev-only folders (must NEVER ship)
^inst/dev$
^inst/dev/.*$

# MVP / experimental work
^_DDESONN_MVP_Test$
^_DDESONN_MVP_Test/.*$

# RStudio / IDE
^\.Rproj\.user$
^\.Rhistory$
^\.RData$
^\.Ruserdata$
^DDESONN\.Rproj$

# Git / VCS
^\.git$
^\.gitignore$
^\.github$
^\.github/.*$

# Build artifacts
^dist$
^build$
^tarballs$
^.*\.tar\.gz$                                                             #$$$$$$$$$$$$$ FIX: safer tarball ignore

# OS junk
^Thumbs\.db$
^\.DS_Store$

# Large analysis outputs / scratch
^analysis$
^analysis/.*$
^scratch$
^scratch/.*$

# ============================================================
# Runtime output capture (MUST NEVER SHIP)                     #$$$$$$$$$$$$$
# ============================================================

^stdout$                                                                   #$$$$$$$$$$$$$
^stderr$                                                                   #$$$$$$$$$$$$$
^DDESONN/stdout$                                                           #$$$$$$$$$$$$$
^DDESONN/stderr$                                                           #$$$$$$$$$$$$$

# ============================================================
# Quarto / vignette intermediates (safe to ignore)
# ============================================================

^vignettes/.*\.knit\.md$
^vignettes/.*\.utf8\.md$
^vignettes/.*_files$
^vignettes/.*_cache$

^vignettes/figure-html$                                                    #$$$$$$$$$$$$$ FIX: knitr fig.path root
^vignettes/figure-html/.*$                                                 #$$$$$$$$$$$$$ FIX
^vignettes/cache$                                                          #$$$$$$$$$$$$$ FIX: knitr cache.path root
^vignettes/cache/.*$                                                       #$$$$$$$$$$$$$ FIX

^vignettes/DDESONN_plots_.*$                                               #$$$$$$$$$$$$$ FIX: your scenario outputs under vignettes
^vignettes/DDESONN_plots_.*/.*$                                            #$$$$$$$$$$$$$ FIX

# ============================================================
# R CMD build metadata
# ============================================================

^doc$
^Meta$
^\.RDataTmp$
