# ============================================================
# .Rbuildignore
#
# Notes:
# - PRESERVED: your structure + nearly all patterns
# - FIX: ignore DDESONN.Rcheck (local check dir)
# - FIX: correct bad regex at end (^\.\.pdf$ -> ^.*\.pdf$ or remove)
# - FIX: tighten README.html and ensure it's excluded
# ============================================================

# Dev-only folders
^inst/dev$ 
^inst/dev/.*$

# MVP / experimental work
^_DDESONN_MVP_Test$
^_DDESONN_MVP_Test/.*$

# RStudio / IDE
^\.Rproj\.user$
^\.Rhistory$
^\.RData$
^\.Ruserdata$
^DDESONN\.Rproj$

# Git / VCS
^\.git$
^\.gitignore$
^\.github$
^\.github/.*$

# Build artifacts
^dist$
^build$
^tarballs$
^.*\.tar\.gz$

# FIX: R CMD check output folder
^DDESONN\.Rcheck$

# OS junk
^Thumbs\.db$
^\.DS_Store$

# Large analysis outputs / scratch
^analysis$
^analysis/.*$
^scratch$
^scratch/.*$

# Runtime output capture
^stdout$
^stderr$
^DDESONN/stdout$
^DDESONN/stderr$

# Vignette intermediates and generated outputs
^vignettes/.*\.knit\.md$
^vignettes/.*\.utf8\.md$
^vignettes/.*_cache$
^vignettes/.*_files$
^vignettes/.*_files/.*$
^vignettes/.*\.html$
^vignettes/.*/artifacts$
^vignettes/.*/artifacts/.*$
^vignettes/artifacts$
^vignettes/artifacts/.*$
^vignettes/figure-html$
^vignettes/figure-html/.*$
^vignettes/cache$
^vignettes/cache/.*$
^vignettes/DDESONN_plots_.*$
^vignettes/DDESONN_plots_.*/.*$

# R CMD build metadata
^doc$
^Meta$
^\.RDataTmp$

# Optional packaging choices
^LICENSE\.md$

# Local plot dumps / scratch
^plots$

# Exclude locally generated README HTML (CRAN renders its own)
^README\.html$

# Exclude standalone PDF files from package root (avoid accidental inclusion)
^.*\.pdf$

