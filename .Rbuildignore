# Dev-only folders
^inst/dev$
^inst/dev/.*$

# MVP / experimental work
^_DDESONN_MVP_Test$
^_DDESONN_MVP_Test/.*$

# RStudio / IDE
^\.Rproj\.user$
^\.Rhistory$
^\.RData$
^\.Ruserdata$
^DDESONN\.Rproj$

# Git / VCS
^\.git$
^\.gitignore$
^\.github$
^\.github/.*$

# Build artifacts
^dist$
^build$
^tarballs$
^.*\.tar\.gz$

# OS junk
^Thumbs\.db$
^\.DS_Store$

# Large analysis outputs / scratch
^analysis$
^analysis/.*$
^scratch$
^scratch/.*$

# Runtime output capture
^stdout$
^stderr$
^DDESONN/stdout$
^DDESONN/stderr$

# Vignette intermediates and generated outputs
^vignettes/.*\.knit\.md$
^vignettes/.*\.utf8\.md$
^vignettes/.*_cache$
^vignettes/.*_files$
^vignettes/.*_files/.*$
^vignettes/.*\.html$
^vignettes/.*/artifacts$
^vignettes/.*/artifacts/.*$
^vignettes/artifacts$
^vignettes/artifacts/.*$
^vignettes/figure-html$
^vignettes/figure-html/.*$
^vignettes/cache$
^vignettes/cache/.*$
^vignettes/DDESONN_plots_.*$
^vignettes/DDESONN_plots_.*/.*$

# R CMD build metadata
^doc$
^Meta$
^\.RDataTmp$
^LICENSE\.md$
^plots$
^README\.html$
^\.\.pdf$
