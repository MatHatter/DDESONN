# ============================================================
# FILE: .gitignore
# FULL FIXED — ignore vignette build outputs + deep figure paths that break Windows copies
#
# PRESERVED:
# - Your existing ignore rules + layout
#
# ADD:
# - vignettes/*_files and vignettes/*_cache (knitr intermediates)                 
# - vignettes/figure-html and vignettes/cache (your knitr::opts_chunk$set roots)  
# - vignettes/DDESONN_plots_* (scenario outputs written under vignette trees)     
# ============================================================

# ============================================================
# Local / IDE
# ============================================================
.Rhistory
.RData
.RDataTmp
.Rproj.user/

# Local package build outputs and editor backup files
*.tar.gz
*.bak_nonascii_*
*.bak_nonascii2_*

# Excel temp files
~$*.xlsx

# ============================================================
# Runtime / generated outputs (DDESONN)
# ============================================================

# Centralized artifact/plot roots (repo-local legacy)
analysis/
artifacts/
plots/

# Legacy repo-root plot dump (old behavior)
EvaluatePredictionsReportPlots/

# Optional: specific legacy generated file (if you still produce it)
misclassified_cases.xlsx

# ============================================================
# Vignettes — knitr/quarto intermediates (NEVER commit)
# ============================================================
vignettes/*_files/                                                         
vignettes/*_cache/                                                         

vignettes/figure-html/                                                     
vignettes/cache/                                                           

vignettes/DDESONN_plots_*/                                                 

# ============================================================
# Optional: if you REALLY want to ignore generated binaries,
# do it only inside output dirs (NOT globally)
# ============================================================
analysis/**/*.png
analysis/**/*.pdf
analysis/**/*.xlsx
analysis/**/*.rds

artifacts/**/*.png
artifacts/**/*.pdf
artifacts/**/*.xlsx
artifacts/**/*.rds

plots/**/*.png
plots/**/*.pdf
plots/**/*.xlsx
plots/**/*.rds

EvaluatePredictionsReportPlots/**/*.png
EvaluatePredictionsReportPlots/**/*.pdf
EvaluatePredictionsReportPlots/**/*.xlsx
EvaluatePredictionsReportPlots/**/*.rds

/doc/
/Meta/



# Local R CMD check/build directories
/*.Rcheck/
/..Rcheck/
/DDESONN.Rcheck/